{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "deadkeys",
  "compatibility_date": "2026-11-01",
  // no_handle_cross_request_promise_resolution: la caché de respuestas de Next comparte promesas entre
  // peticiones; con ese comportamiento activo (por defecto en fechas recientes) toda página da error 500.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public", "no_handle_cross_request_promise_resolution"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Autorreferencia que usa OpenNext para la caché; el nombre debe coincidir con el del Worker.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "deadkeys"
    }
  ],
  // Namespace "deadkeys-next-inc-cache-kv" (creado automáticamente en el primer deploy).
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "060a532456564ae588433db23b7fb764"
    }
  ],
  // Rate Limiting nativo de Workers, por IP (src/lib/rate-limit.ts). period solo admite 10 o 60 segundos.
  // namespace_id es un número elegido libremente, único en la cuenta de Cloudflare.
  "ratelimits": [
    { "name": "RL_SEARCH", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_BUILD_ITEMS", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_ADMIN_LOGIN", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } }
  ],
  "observability": {
    "enabled": true
  }
}
